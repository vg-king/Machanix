    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.5",
    "vite": "5.4.14",
    "zod": "^4.6.7"
